{
  "opencollection": "1.0.0",
  "info": {
    "name": "UKG Pro HCM Benefits People API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "People",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List employees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantHostName}/api/personnel/v1/employees",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items per page"
              }
            ]
          },
          "docs": "Retrieve a paginated list of employees for the tenant."
        },
        {
          "info": {
            "name": "Retrieve an employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantHostName}/api/personnel/v1/employees/:employeeId",
            "params": [
              {
                "name": "employeeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an employee"
        }
      ]
    }
  ],
  "bundled": true
}